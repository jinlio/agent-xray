name: CI

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Lint
        run: uv run ruff check src tests
      - name: Test
        run: uv run pytest -v
      - name: Build package
        run: uv build
      - name: Smoke test CLI
        run: |
          uv run agent-xray --version
          uv run agent-xray --help
